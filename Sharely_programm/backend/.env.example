# Vorlage: als Sharely_programm/backend/.env kopieren und anpassen. Die .env wird nie committet.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATENBANK=sharely
UPLOAD_ORDNER=../uploads
# Bilder: "ordner" = UPLOAD_ORDNER auf diesem Rechner, "bucket" = gemeinsamer Railway Storage Bucket.
# Werte aus Railway (Bucket → Credentials), siehe README.md Abschnitt „Bilder“.
BILDSPEICHER=ordner
# Speicher für Bilder je Nutzer in MB (1024 = 1 GB)
MAX_SPEICHER_MB_PRO_NUTZER=1024
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
FRONTEND_URLS=["http://localhost:5173"]
