><mxCell id="c_gelesene_neuigkeiten" value="gelesene_neuigkeiten" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#2F5FB3;fontColor=#FFFFFF;strokeColor=#2F5FB3;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="1525" y="1006" width="465" height="152" as="geometry"/></mxCell><mxCell id="c_gelesene_neuigkeiten_0" value="PK _id &lt;span style=&quot;color:#5A6070&quot;&gt;: ObjectId&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;fontColor=#B98900;fontStyle=1;" vertex="1" parent="c_gelesene_neuigkeiten"><mxGeometry y="40" width="465" height="25" as="geometry"/></mxCell><mxCell id="c_gelesene_neuigkeiten_1" value="neuigkeit_id &lt;span style=&quot;color:#2F7D57&quot;&gt;: → neuigkeiten&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;fontColor=#2F7D57;" vertex="1" parent="c_gelesene_neuigkeiten"><mxGeometry y="65" width="465" height="25" as="geometry"/></mxCell><mxCell id="c_gelesene_neuigkeiten_2" value="nutzer_id &lt;span style=&quot;color:#2F7D57&quot;&gt;: → nutzer&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;fontColor=#2F7D57;" vertex="1" parent="c_gelesene_neuigkeiten"><mxGeometry y="90" width="465" height="25" as="geometry"/></mxCell><mxCell id="c_gelesene_neuigkeiten_3" value="gelesen_am &lt;span style=&quot;color:#5A6070&quot;&gt;: Date&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="c_gelesene_neuigkeiten"><mxGeometry y="115" width="465" height="25" as="geometry"/></mxCell><mxCell id="c_idx" value="&lt;b&gt;Indizes (neben _id)&lt;/b&gt;&lt;br&gt;nutzer: email, nutzername eindeutig&lt;br&gt;sitzungen / passwort_resets: token_hash eindeutig,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;laeuft_ab_am als TTL-Index (löscht automatisch)&lt;br&gt;kleidungsstuecke: (nutzer_id, status, kleidungsart),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(nutzer_id, favorit), (nutzer_id, privat), kategorie_ids&lt;br&gt;kategorien: (nutzer_id, name) eindeutig&lt;br&gt;outfits: nutzer_id, kategorie_ids, teile.kleidungsstueck_id&lt;br&gt;figuren: nutzer_id&lt;br&gt;freundschaften: (anfragender_id, angefragter_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;eindeutig, dazu angefragter_id&lt;br&gt;leihvorgaenge: kleidungsstueck_id, besitzer_id,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;empfaenger_id&lt;br&gt;gelesene_neuigkeiten: (nutzer_id, neuigkeit_id) eindeutig&lt;br&gt;&lt;b&gt;Feste Wertelisten im Code (keine Collection)&lt;/b&gt;&lt;br&gt;farbe: schwarz, weiss, grau, beige, braun, rot, rosa,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;orange, gelb, gruen, blau, dunkelblau, lila, bunt&lt;br&gt;material: baumwolle, polyester, wolle, leinen, seide,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;leder, jeans, viskose, sonstiges&lt;br&gt;saison: fruehling, sommer, herbst, winter, ganzjaehrig&lt;br&gt;messpunkt: die 22 Messbänder der Avatar-GLB aus&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;docs/avatar/messpunkte.json (bust-circ, waist-circ …)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#A0A7B4;fontSize=12;fontColor=#5A6070;" vertex="1" parent="1"><mxGeometry x="1030" y="614" width="465" height="532" as="geometry"/></mxCell><mxCell id="c_t" value="&lt;b style=&quot;font-size:24px&quot;&gt;Sharely – Umsetzung in MongoDB: Collections und Felder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5A6070&quot;&gt;PK = Primärschlüssel _id · → = Verweis · grau hinterlegt = eingebettet&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram>
